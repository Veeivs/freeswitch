<!-- /etc/freeswitch/dialplan/default.xml -->
<extension name="outbound_calls">
      <condition field="destination_number" expression="^(\d{10})$">
            <action application="set" data="effective_caller_id_number=YOUR_NUMBER"/>
            <action application="bridge" data="sofia/gateway/telnyx/$1"/>
      </condition>
</extension>

<extension name="inbound_calls">
      <condition field="destination_number" expression="^(YOUR_DID)$">
            <action application="answer"/>
            <action application="playback" data="/path/to/audio.wav"/>
            <action application="hangup"/>
      </condition>
</extension>