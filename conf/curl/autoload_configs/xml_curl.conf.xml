<configuration name="xml_curl.conf" description="cURL XML Gateway">
  <bindings>
    <!-- Directory lookups -->
    <binding name="directory">
      <!-- for local development [ngrok] -->
      <param name="gateway-url" value="https://pretty-grand-oriole.ngrok-free.app/freeswitch/directory" bindings="directory"/>
      <!-- for production -->
      <!-- <param name="gateway-url" value="http://YOUR_API_SERVER:3000/freeswitch/directory" bindings="directory"/> -->
      <param name="gateway-credentials" value="user:pass"/>
      <param name="timeout" value="10"/>
    </binding>

    <!-- Dialplan lookups -->
    <binding name="dialplan">
      <!-- for local development [ngrok] -->
      <param name="gateway-url" value="https://pretty-grand-oriole.ngrok-free.app/freeswitch/dialplan" bindings="dialplan"/>
      <!-- for production -->
      <!-- <param name="gateway-url" value="http://YOUR_API_SERVER:3000/freeswitch/dialplan" bindings="dialplan"/> -->
      <param name="gateway-credentials" value="user:pass"/>
      <param name="timeout" value="10"/>
    </binding>
  </bindings>
</configuration>


